# Copy to `.env` and fill in values. Never commit `.env`.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL (used by `supabase db push` and server-side queries)
# Dashboard → Project Settings → Database → Connection string → Direct
DATABASE_URL=

# ── Resend ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Swap to a verified domain address when ready
RESEND_FROM_EMAIL=onboarding@resend.dev
